#include "winresrc.h"
/////////////////////////////////////////////////////////////////////////////
//
// Icon
//

// Icon with lowest ID value placed first to ensure application icon
// remains consistent on all systems.
// QT requires that the default application icon is named IDI_ICON1

#define IDI_ICON1 1
IDI_ICON1               ICON                    "../../dist/nxn1x.ico"


/////////////////////////////////////////////////////////////////////////////
//
// RT_MANIFEST
//

0                       RT_MANIFEST             "../../dist/yuzu.manifest"

1 VERSIONINFO
 FILEVERSION 2,0,0,0
 PRODUCTVERSION 2,0,0,0
 FILEOS 0x40004L
 FILETYPE 0x1L
BEGIN
 BLOCK "StringFileInfo"
 BEGIN
  BLOCK "040904b0"
  BEGIN
   VALUE "CompanyName", "NXN1X contributors\0"
   VALUE "FileDescription", "NXN1X 2.0\0"
   VALUE "FileVersion", "2.0.0.0\0"
   VALUE "InternalName", "NXN1X\0"
   VALUE "OriginalFilename", "NXN1X.exe\0"
   VALUE "ProductName", "NXN1X 2.0\0"
   VALUE "ProductVersion", "2.0.0.0\0"
   VALUE "LegalCopyright", "SnapRYU, Eden and yuzu contributors; see licenses\0"
  END
 END
 BLOCK "VarFileInfo"
 BEGIN
  VALUE "Translation", 0x409, 1200
 END
END
